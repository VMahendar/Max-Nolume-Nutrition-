# Enter these in the host's environment settings, not in a tracked .env file.
NODE_ENV=production
NODE_VERSION=24.19.0
HOST=0.0.0.0
STAGING_MODE=true
DATA_DIR=/var/data/mvn-staging
STAGING_USERNAME=reviewer
STAGING_PASSWORD_HASH=SET_PRIVATE_SCRYPT_HASH
STAGING_ADMIN_PASSWORD=SET_A_DIFFERENT_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
STAGING_CUSTOMER_PASSWORD=SET_ANOTHER_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
RAZORPAY_TESTED=false
LIVE_PAYMENTS_APPROVED=false
POLICIES_APPROVED=false
SHIPROCKET_ENABLED=false
SHIPROCKET_TESTED=false
TRUST_PROXY=false
# Omit PUBLIC_ORIGIN on Render: staging-server uses RENDER_EXTERNAL_URL.
# On another host, set PUBLIC_ORIGIN to the exact real HTTPS URL.
# No Razorpay or Shiprocket credentials are needed or permitted for this preview.
