NODE_ENV=development
HOST=127.0.0.1
TRUST_PROXY=false
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Once an owned custom domain is verified on Render, set this to https://maxvolumenutrition.com
# STORE_PUBLIC_URL updates homepage canonical, OG, structured data and sitemap without replacing staging URL until ready.
STORE_PUBLIC_URL=
DATA_DIR=./runtime
# Keep all integrations disabled until account-specific tests are complete.
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
RAZORPAY_TESTED=false
LIVE_PAYMENTS_APPROVED=false
POLICIES_APPROVED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_ENABLED=false
SHIPROCKET_TESTED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=

# Optional on-disk SQLite recovery backups. Requires DATA_DIR under /var/data/.
# Creates and verifies a private backup shortly after startup and once daily.
# These are SAME-DISK backups, not offsite disaster recovery.
BACKUP_LOCAL_ENABLED=false
